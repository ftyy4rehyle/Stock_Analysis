@model StockAnalysis.ViewModels.ScreeningPageViewModel
@using StockAnalysis.Services
@{
    ViewData["Title"] = "每日篩選";
}

<div class="row mb-3">
    <div class="col">
        <h4 class="fw-bold"><i class="bi bi-funnel-fill text-success me-2"></i>每日盤後篩選</h4>
        <p class="text-muted small mb-0">篩選條件：成交量 &gt; 20日均量 × 1.5 <span class="text-danger fw-bold">且</span> 收盤價 &gt; MA20</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label fw-semibold mb-1">選擇日期</label>
                <select name="date" class="form-select" onchange="this.form.submit()">
                    @foreach (var date in Model.AvailableDates)
                    {
                        <option value="@date.ToString("yyyy-MM-dd")"
                                selected="@(date == Model.SelectedDate)">
                            @date.ToString("yyyy/MM/dd") (週@("日一二三四五六"[((int)date.DayOfWeek)]))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                @if (Model.SelectedDate.HasValue)
                {
                    <a asp-action="ExportExcel" asp-route-date="@Model.SelectedDate.Value.ToString("yyyy-MM-dd")"
                       class="btn btn-success btn-sm w-100">
                        <i class="bi bi-file-earmark-excel me-1"></i>匯出 Excel
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Results.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">
                篩選結果
                <span class="badge bg-success ms-2">@Model.Results.Count 檔</span>
                @if (Model.SelectedDate.HasValue)
                {
                    <span class="text-muted fw-normal ms-2 small">@Model.SelectedDate.Value.ToString("yyyy/MM/dd")</span>
                }
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>代號</th>
                            <th>名稱</th>
                            <th>產業</th>
                            <th class="text-end">收盤</th>
                            <th class="text-end">漲跌%</th>
                            <th class="text-end">成交量(張)</th>
                            <th class="text-end">20日均量</th>
                            <th class="text-end">量比</th>
                            <th class="text-end">MA20</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Results)
                        {
                            var upCss = r.ChangePercent > 0 ? "text-danger" : r.ChangePercent < 0 ? "text-success" : "";
                            <tr>
                                <td class="fw-bold">@r.Symbol</td>
                                <td>@r.Name</td>
                                <td><span class="badge bg-light text-dark">@TwseIndustryHelper.Resolve(r.Industry)</span></td>
                                <td class="text-end fw-semibold">@r.Close.ToString("N2")</td>
                                <td class="text-end @upCss">
                                    @(r.ChangePercent > 0 ? "+" : "")@r.ChangePercent.ToString("N2")%
                                </td>
                                <td class="text-end">@r.Volume.ToString("N0")</td>
                                <td class="text-end text-muted">@r.AvgVolume20.ToString("N0")</td>
                                <td class="text-end">
                                    <span class="badge bg-warning text-dark">@r.VolumeRatio.ToString("N2")x</span>
                                </td>
                                <td class="text-end text-info">@r.MA20.ToString("N2")</td>
                                <td>
                                    <a asp-controller="Stock" asp-action="Query"
                                       asp-route-symbol="@r.Symbol"
                                       class="btn btn-outline-primary btn-sm py-0">查看</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 mb-3 d-block"></i>
            <p>所選日期無符合篩選條件的股票</p>
            <small>請嘗試選擇其他日期</small>
        </div>
    </div>
}
