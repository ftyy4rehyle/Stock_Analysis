<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 台股盤後分析系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-graph-up-arrow me-1"></i>台股盤後分析
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-fill me-1"></i>首頁
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Stock" asp-action="Query">
                                <i class="bi bi-search me-1"></i>股票查詢
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Screening" asp-action="Index">
                                <i class="bi bi-funnel-fill me-1"></i>每日篩選
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Backtest" asp-action="Index">
                                <i class="bi bi-clock-history me-1"></i>回測
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="Admin" asp-action="Sync">
                                <i class="bi bi-cloud-download me-1"></i>資料同步
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light mt-4 py-3">
        <div class="container text-center small">
            台股盤後分析系統 &copy; @DateTime.Now.Year &nbsp;|&nbsp;
            資料僅供參考，投資需自行承擔風險
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
